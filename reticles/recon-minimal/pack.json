{
  "format": "heat.reticle",
  "version": 1,
  "name": "Recon Minimal",
  "author": "HEAT Sentinel",
  "hide": [
    "ammo_wheel",
    "reload_clock",
    "loader_ammo_count",
    "aim_static_ring",
    "aim_ring_shadow",
    "aim_reload_ring",
    "aim_ring_highlight",
    "aim_centre_mark",
    "aim_front_sight",
    "scope_reticle",
    "range_readout"
  ],
  "widgets": [
    {
      "t": "ring",
      "track": "none",
      "r": -0.5,
      "r_track": "spread",
      "r_scale": 0.5,
      "r_min": 14.5,
      "r_max": 8000,
      "width": 1,
      "color": "rgba(248,247,246,0.45)",
      "shadow": "rgba(0,0,0,0.5)",
      "shadow_width": 2,
      "when": {
        "crosshair_type": [
          "Common"
        ]
      }
    },
    {
      "t": "dot",
      "shape": "plus",
      "w": 10,
      "thickness": 1.5,
      "gap": 3,
      "color": "#f8f7f6ff",
      "border": true,
      "border_width": 1,
      "border_color": "rgba(0,0,0,0.5)"
    },
    {
      "t": "strips",
      "sides": "both",
      "count": 5,
      "len": 10,
      "thickness": 1.5,
      "offset": 10,
      "r_track": "spread",
      "r_scale": 0.5,
      "r_min": 25,
      "r_max": 8000,
      "step": 8,
      "taper": 0.6,
      "color": "#f8f7f6ff",
      "shadow": "rgba(0,0,0,0.5)",
      "shadow_width": 2
    },
    {
      "t": "strips",
      "sides": "vertical",
      "count": 3,
      "len": 8,
      "thickness": 1.5,
      "offset": 18,
      "r_track": "spread",
      "r_scale": 0.5,
      "r_min": 33,
      "r_max": 8000,
      "step": 10,
      "taper": 0.5,
      "color": "rgba(248,247,246,0.7)",
      "shadow": "rgba(0,0,0,0.5)",
      "shadow_width": 2
    },
    {
      "t": "ring",
      "track": "reload",
      "r": 3,
      "r_track": "spread",
      "r_scale": 0.5,
      "r_min": 18,
      "r_max": 8000,
      "width": 1.5,
      "cap": "butt",
      "color": "#f8f7f6ff",
      "color_bg": null,
      "when": {
        "crosshair_type": [
          "Common"
        ],
        "reloading": true,
        "heat_gun": false
      }
    },
    {
      "t": "text",
      "text": "{time_left:1}",
      "y": 96,
      "size": 14,
      "font": "Normalidad Compact 500",
      "color": "#f8f7f6ff",
      "shadow": "rgba(0,0,0,0.5)",
      "when": {
        "reloading": true,
        "heat_gun": false
      }
    },
    {
      "t": "shells",
      "layout": "stack",
      "x": 96,
      "y": -2,
      "cell_w": 12,
      "cell_h": 3,
      "gap": 3,
      "fill_dir": "right",
      "color_ready": "#f8f7f6ff",
      "color_loading": "#ffb347ff",
      "color_paused": "#ff6d46ff",
      "color_empty": "rgba(248,247,246,0.16)",
      "when": {
        "magazine_min": 2,
        "magazine_max": 16
      },
      "source": "primary"
    },
    {
      "t": "bar",
      "track": "magazine",
      "x": 100,
      "y": -60,
      "w": 3,
      "h": 60,
      "fill_dir": "up",
      "color": "#f8f7f6ff",
      "color_bg": "rgba(248,247,246,0.16)",
      "when": {
        "magazine_min": 17
      },
      "source": "primary"
    },
    {
      "t": "text",
      "text": "{shells_ready}",
      "x": 101,
      "y": -70,
      "size": 12,
      "font": "Normalidad Compact 400",
      "color": "#f8f7f6ff",
      "shadow": "rgba(0,0,0,0.5)",
      "when": {
        "magazine_min": 17
      },
      "source": "primary"
    },
    {
      "t": "text",
      "text": "+{shell_time_left:1}",
      "x": 102,
      "y": 14,
      "size": 12,
      "font": "Normalidad Compact 400",
      "color": "#ffb347ff",
      "shadow": "rgba(0,0,0,0.5)",
      "when": {
        "magazine_min": 2,
        "round_loading": true
      },
      "source": "primary"
    },
    {
      "t": "bar",
      "track": "heat",
      "x": -94,
      "y": -64,
      "w": 3,
      "h": 56,
      "fill_dir": "up",
      "color": "#f8f7f6ff",
      "color_bg": "rgba(248,247,246,0.16)",
      "when": {
        "heat_gun": true,
        "heat_phase": [
          "idle",
          "heating",
          "cooling",
          "overheat",
          "overheat_cooling"
        ]
      },
      "source": "primary"
    },
    {
      "t": "bar",
      "track": "heat",
      "x": -94,
      "y": -64,
      "w": 3,
      "h": 56,
      "fill_dir": "up",
      "color": "#f8f7f6ff",
      "color_bg": "rgba(248,247,246,0.16)",
      "when": {
        "heat_gun": true,
        "heat_phase": [
          "delay"
        ]
      },
      "source": "primary",
      "opacity": 0.4
    },
    {
      "t": "bar",
      "track": "heat_delay",
      "x": -94,
      "y": -64,
      "w": 3,
      "h": 56,
      "fill_dir": "up",
      "color": "#f8f7f6ff",
      "when": {
        "heat_gun": true,
        "heat_phase": [
          "delay"
        ]
      },
      "source": "primary",
      "bg_sweep": false
    },
    {
      "t": "bar",
      "track": "heat",
      "x": -94,
      "y": -64,
      "w": 3,
      "h": 56,
      "color": "#ff6d46ff",
      "color_bg": null,
      "when": {
        "overheated": true
      },
      "source": "primary"
    },
    {
      "t": "text",
      "text": "HOT",
      "x": -93,
      "y": 14,
      "size": 11,
      "font": "Normalidad Compact 500",
      "color": "#ff6d46ff",
      "shadow": "rgba(0,0,0,0.5)",
      "when": {
        "overheated": true
      }
    },
    {
      "t": "bar",
      "source": "secondary",
      "track": "magazine",
      "x": -102,
      "y": -64,
      "w": 2,
      "h": 56,
      "fill_dir": "up",
      "color": "#ffb347ff",
      "color_bg": null
    },
    {
      "t": "text",
      "source": "secondary",
      "text": "{shells_ready}",
      "x": -101,
      "y": -74,
      "size": 12,
      "font": "Normalidad Compact 400",
      "color": "#ffb347ff",
      "shadow": "rgba(0,0,0,0.5)"
    },
    {
      "t": "text",
      "text": "{distance:0} m",
      "x": 102,
      "y": 30,
      "size": 12,
      "font": "Normalidad Compact 400",
      "align": "left",
      "color": "#f8f7f6ff",
      "shadow": "rgba(0,0,0,0.5)",
      "when": {
        "range_shown": true,
        "range_close": false
      }
    },
    {
      "t": "text",
      "text": "{distance:0} m",
      "x": 102,
      "y": 30,
      "size": 12,
      "font": "Normalidad Compact 400",
      "align": "left",
      "color": "#ff6d46ff",
      "shadow": "rgba(0,0,0,0.5)",
      "when": {
        "range_close": true
      }
    },
    {
      "t": "text",
      "text": "+{shell_time_left:1}",
      "x": -101,
      "y": -60.0,
      "size": 12,
      "font": "Normalidad Compact 400",
      "color": "#ffb347ff",
      "shadow": "rgba(0,0,0,0.5)",
      "when": {
        "round_loading": true
      },
      "source": "secondary"
    }
  ]
}
