{
  "format": "heat.reticle",
  "version": 1,
  "name": "Phosphor",
  "author": "HEAT Sentinel",
  "hide": [
    "ammo_wheel",
    "reload_clock",
    "loader_ammo_count",
    "aim_static_ring",
    "aim_ring_shadow",
    "aim_reload_ring",
    "aim_ring_highlight",
    "aim_centre_mark",
    "aim_front_sight",
    "scope_reticle",
    "range_readout",
    "aim_gatling",
    "aim_tracker"
  ],
  "widgets": [
    {
      "t": "ring",
      "track": "none",
      "r": 16,
      "width": 1.4,
      "from_deg": 30,
      "sweep_deg": 30,
      "bg_sweep": true,
      "cap": "round",
      "color": "#7cffa0ff",
      "when": {
        "crosshair_type": [
          "TargetTrackerGun",
          "Mim146Missiles"
        ]
      }
    },
    {
      "t": "ring",
      "track": "none",
      "r": 16,
      "width": 1.4,
      "from_deg": 120,
      "sweep_deg": 30,
      "bg_sweep": true,
      "cap": "round",
      "color": "#7cffa0ff",
      "when": {
        "crosshair_type": [
          "TargetTrackerGun",
          "Mim146Missiles"
        ]
      }
    },
    {
      "t": "ring",
      "track": "none",
      "r": 16,
      "width": 1.4,
      "from_deg": 210,
      "sweep_deg": 30,
      "bg_sweep": true,
      "cap": "round",
      "color": "#7cffa0ff",
      "when": {
        "crosshair_type": [
          "TargetTrackerGun",
          "Mim146Missiles"
        ]
      }
    },
    {
      "t": "ring",
      "track": "none",
      "r": 16,
      "width": 1.4,
      "from_deg": 300,
      "sweep_deg": 30,
      "bg_sweep": true,
      "cap": "round",
      "color": "#7cffa0ff",
      "when": {
        "crosshair_type": [
          "TargetTrackerGun",
          "Mim146Missiles"
        ]
      }
    },
    {
      "t": "ring",
      "track": "reload",
      "r": 12,
      "width": 2,
      "cap": "round",
      "color": "#7cffa0ff",
      "color_bg": null,
      "when": {
        "crosshair_type": [
          "TargetTrackerGun",
          "Mim146Missiles"
        ],
        "reloading": true,
        "heat_gun": false
      }
    },
    {
      "t": "strips",
      "sides": "all",
      "count": 1,
      "len": 5,
      "thickness": 1.2,
      "offset": -0.5,
      "r_track": "spread",
      "r_scale": 0.5,
      "r_min": 14.5,
      "r_max": 8000,
      "color": "#7cffa0ff",
      "when": {
        "crosshair_type": [
          "Common",
          "GatlingGun",
          "GatlingGunWithOverheat",
          "MachineGunMechanic"
        ]
      },
      "cap": "round"
    },
    {
      "t": "ring",
      "track": "none",
      "r": -0.5,
      "r_track": "spread",
      "r_scale": 0.5,
      "r_min": 14.5,
      "r_max": 8000,
      "width": 1.2,
      "color": "#7cffa0ff",
      "shadow": "rgba(0,18,8,0.18)",
      "shadow_width": 3,
      "when": {
        "crosshair_type": [
          "Common",
          "GatlingGun",
          "GatlingGunWithOverheat",
          "MachineGunMechanic"
        ],
        "reloading": false
      },
      "cap": "round"
    },
    {
      "t": "ring",
      "track": "none",
      "r": -0.5,
      "r_track": "spread",
      "r_scale": 0.5,
      "r_min": 14.5,
      "r_max": 8000,
      "width": 1.2,
      "color": "#7cffa0ff",
      "when": {
        "crosshair_type": [
          "Common",
          "GatlingGun",
          "GatlingGunWithOverheat",
          "MachineGunMechanic"
        ],
        "reloading": true
      },
      "cap": "round",
      "opacity": 0.3
    },
    {
      "t": "dot",
      "shape": "circle",
      "w": 2.5,
      "h": 2.5,
      "color": "#7cffa0ff",
      "when": {
        "crosshair_type": [
          "Common",
          "GatlingGun",
          "GatlingGunWithOverheat",
          "MachineGunMechanic",
          "TargetTrackerGun",
          "Mim146Missiles"
        ]
      }
    },
    {
      "t": "ring",
      "track": "reload",
      "r": -0.5,
      "r_track": "spread",
      "r_scale": 0.5,
      "r_min": 14.5,
      "r_max": 8000,
      "width": 2,
      "cap": "round",
      "color": "#7cffa0ff",
      "color_bg": null,
      "when": {
        "crosshair_type": [
          "Common",
          "GatlingGun",
          "GatlingGunWithOverheat",
          "MachineGunMechanic"
        ],
        "reloading": true,
        "heat_gun": false
      }
    },
    {
      "t": "shape",
      "sp": [
        {
          "p": [
            [
              0,
              -40
            ],
            [
              0,
              30
            ]
          ],
          "c": false
        }
      ],
      "scale": 1,
      "x": 84,
      "fill": null,
      "stroke": "rgba(124,255,160,0.4)",
      "sw": 1,
      "cap": "round",
      "join": "round"
    },
    {
      "t": "text",
      "text": "RLD {time_left:1}",
      "x": 90,
      "y": -32,
      "size": 12,
      "font": "Normalidad Extended 400",
      "align": "left",
      "color": "#7cffa0ff",
      "shadow": "rgba(0,18,8,0.35)",
      "when": {
        "reloading": true,
        "heat_gun": false
      }
    },
    {
      "t": "text",
      "text": "RDY",
      "x": 90,
      "y": -32,
      "size": 12,
      "font": "Normalidad Extended 400",
      "align": "left",
      "color": "#7cffa0ff",
      "shadow": "rgba(0,18,8,0.35)",
      "when": {
        "reloading": false,
        "heat_gun": false
      }
    },
    {
      "t": "text",
      "text": "MAG {shells_ready}/{magazine}",
      "x": 90,
      "y": -18,
      "size": 11,
      "font": "Normalidad Extended 400",
      "align": "left",
      "color": "#7cffa0ff",
      "shadow": "rgba(0,18,8,0.35)",
      "when": {
        "magazine_min": 2
      },
      "source": "primary"
    },
    {
      "t": "text",
      "text": "NXT {shell_time_left:1}",
      "x": 90,
      "y": -4,
      "size": 11,
      "font": "Normalidad Extended 400",
      "align": "left",
      "color": "rgba(124,255,160,0.4)",
      "shadow": "rgba(0,18,8,0.35)",
      "when": {
        "magazine_min": 2,
        "round_loading": true
      },
      "source": "primary"
    },
    {
      "t": "shells",
      "layout": "row",
      "x": 90,
      "y": 8,
      "cell_w": 4,
      "cell_h": 4,
      "gap": 3,
      "fill_dir": "grow",
      "color_ready": "#7cffa0ff",
      "color_loading": "rgba(124,255,160,0.4)",
      "color_paused": "#ffcf5aff",
      "color_empty": "rgba(124,255,160,0.14)",
      "when": {
        "magazine_min": 2,
        "magazine_max": 12
      },
      "source": "primary",
      "radius": 2.0
    },
    {
      "t": "bar",
      "track": "magazine",
      "x": 90,
      "y": 9,
      "w": 60,
      "h": 2,
      "color": "#7cffa0ff",
      "color_bg": "rgba(124,255,160,0.14)",
      "when": {
        "magazine_min": 13
      },
      "source": "primary",
      "radius": 1.0
    },
    {
      "t": "text",
      "text": "TMP",
      "x": 90,
      "y": 24,
      "size": 10,
      "font": "Normalidad Extended 400",
      "align": "left",
      "color": "#7cffa0ff",
      "shadow": "rgba(0,18,8,0.35)",
      "when": {
        "heat_gun": true
      }
    },
    {
      "t": "bar",
      "track": "heat",
      "x": 120,
      "y": 23,
      "w": 36,
      "h": 2,
      "color": "#7cffa0ff",
      "color_bg": "rgba(124,255,160,0.14)",
      "when": {
        "heat_gun": true,
        "heat_phase": [
          "idle",
          "heating",
          "cooling",
          "overheat",
          "overheat_cooling",
          "delay"
        ]
      },
      "source": "primary",
      "radius": 1.0
    },
    {
      "t": "bar",
      "track": "heat_delay",
      "x": 120,
      "y": 23,
      "w": 36,
      "h": 2,
      "color": "rgba(255,143,51,0.9)",
      "when": {
        "heat_gun": true,
        "heat_phase": [
          "delay"
        ]
      },
      "source": "primary",
      "bg_sweep": false,
      "radius": 1.0,
      "color_bg": null
    },
    {
      "t": "bar",
      "track": "heat",
      "x": 120,
      "y": 23,
      "w": 36,
      "h": 2,
      "color": "#ffcf5aff",
      "color_bg": null,
      "when": {
        "overheated": true
      },
      "source": "primary",
      "radius": 1.0
    },
    {
      "t": "text",
      "text": "OVERHEAT",
      "x": 90,
      "y": 38,
      "size": 11,
      "font": "Normalidad Extended 400",
      "align": "left",
      "color": "#ffcf5aff",
      "shadow": "rgba(0,18,8,0.35)",
      "when": {
        "overheated": true
      }
    },
    {
      "t": "text",
      "source": "secondary",
      "text": "SEC {shells_ready}",
      "x": -84,
      "y": -32,
      "size": 11,
      "font": "Normalidad Extended 400",
      "align": "right",
      "color": "#7cffa0ff",
      "shadow": "rgba(0,18,8,0.35)"
    },
    {
      "t": "bar",
      "source": "secondary",
      "track": "magazine",
      "x": -144,
      "y": -22,
      "w": 60,
      "h": 2,
      "color": "#7cffa0ff",
      "color_bg": null,
      "radius": 1.0
    },
    {
      "t": "text",
      "text": "RNG {distance:0}",
      "x": 90,
      "y": -46,
      "size": 11,
      "font": "Normalidad Extended 400",
      "align": "left",
      "color": "#7cffa0ff",
      "shadow": "rgba(0,18,8,0.35)",
      "when": {
        "range_shown": true,
        "range_close": false
      }
    },
    {
      "t": "text",
      "text": "RNG {distance:0}",
      "x": 90,
      "y": -46,
      "size": 11,
      "font": "Normalidad Extended 400",
      "align": "left",
      "color": "#ffcf5aff",
      "shadow": "rgba(0,18,8,0.35)",
      "when": {
        "range_close": true
      }
    },
    {
      "t": "text",
      "text": "NXT {shell_time_left:1}",
      "x": -84,
      "y": -18.0,
      "size": 11,
      "font": "Normalidad Extended 400",
      "align": "right",
      "color": "rgba(124,255,160,0.4)",
      "shadow": "rgba(0,18,8,0.35)",
      "when": {
        "round_loading": true
      },
      "source": "secondary"
    }
  ]
}
